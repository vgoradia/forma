# Public app URL — set after deploy (required for OG images + sitemap)
NEXT_PUBLIC_APP_URL=https://www.shopwithforma.com

# AI API key — use ONE of these
ANTHROPIC_API_KEY=sk-ant-your-key-here
# OPENAI_API_KEY=sk-your-key-here

# Serper — live prices + product images (free tier at serper.dev)
SERPER_API_KEY=your-serper-key-here

# Optional — Amazon Associates tag for affiliate revenue (e.g. yourname-20)
# NEXT_PUBLIC_AMAZON_AFFILIATE_TAG=yourname-20

# Supabase — Google sign-in (see AUTH.md)
# NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Stripe — Forma Plus billing (see STRIPE.md)
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PRICE_ID=price_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# NEXT_PUBLIC_FORMA_PLUS_PRICE=$9.99/mo
